# Generated by `xcodegen generate` from project.yml — never edit or commit.
# ADR-0002 D3: the project definition lives in project.yml, which is reviewable
# text that CI regenerates from.
*.xcodeproj
*.xcworkspace

# Build products
build/
DerivedData/
.build/
dist/

# Xcode user state
xcuserdata/
.swiftpm/

# SwiftPM resolution.
#
# Committed on purpose, and it has to be un-ignored explicitly because the
# `.build/` rule above would otherwise be the only thing keeping it out. It
# pins the exact revisions a build resolves to, which is what makes a CI run
# reproducible. There are no external dependencies today (Package.swift declares
# none — ADR-0002 D4), so the file is nearly empty; that is not a reason to
# ignore it, because the first dependency added is exactly when the pin starts
# mattering.
!Package.resolved

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Local environment
.env
.env.local

# Logs
*.log
